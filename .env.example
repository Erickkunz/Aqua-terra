# ============================================================
# Aqua-Terra - environment variables
# Copy this file to `.env` and fill in real values before deploy
# ============================================================

# ---- Database ----
POSTGRES_DB=aquaterra_db
POSTGRES_USER=aquaterra_user
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ---- App ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_with_64_char_random_string

# `development` | `staging` | `production`
ENVIRONMENT=production

# Set to false in production after first boot
SEED_ON_STARTUP=true

# ---- Branding / contact ----
SITE_NAME=Aqua-Terra
SITE_TAGLINE=Soluciones Integrales en Agua y Tierra
CONTACT_EMAIL=contacto@aquaterra.com
CONTACT_PHONE=+51 1 234 5678

# ---- Default admin (created on first boot) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aquaterra.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---- Reverse proxy / HTTPS ----
# Set to "1" when behind HTTPS reverse proxy so session cookies are secure-only
SESSION_HTTPS_ONLY=0

# ---- Workers (uvicorn) ----
WEB_WORKERS=2
